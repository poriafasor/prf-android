<?xml version="1.0" encoding="utf-8"?>
<!--
    One screen, four things, in the order they are used.

    v2.0.0 deletes every card that existed only to be pressed. The previous
    layout was nine sections — phone, check-in/out, a live camera preview, a
    permission row per permission, battery and specs, the server address, the
    admin button, the screen-share button — and the complaint was accurate: the
    app opened on a page where most of it could not do anything until several
    different things were found and pressed in the right order.

    So everything that was a button is now either automatic or gone:

      - permissions      asked for by the run itself, one dialog at a time
      - the admin grant  asked for by the run, with a settings fallback
      - registration     done by the run
      - the capture card hidden while the run happens, and never a requirement
      - device specs     sent with the record, not shown
      - server address   configured once, not a field

    What is left is what a person actually has to supply: their number, their
    carrier, and one press. The status line under the button is the only other
    thing on screen, and it is the honest account of what just happened.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prf_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- ── the header. Centre-aligned, because it is the one line that
             names the app and it should not be fighting the rest of the page
             for attention. ──────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_title_center"
            android:textColor="@color/prf_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/prf_text_dim"
            android:textSize="13sp" />

        <!-- ── what this phone is allowed to do, in one line ─────────────── -->

        <TextView
            android:id="@+id/gateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_outline"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/prf_text"
            android:textSize="12sp" />

        <!-- The two doors into the device-owner grant. Small, because on a
             phone that is only an admin the panel's app locks are refused by
             the OS and no retry changes that — the only fix is provisioning,
             and the user has to be able to reach it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdmin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/gate_admin_btn"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOwner"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/gate_owner_btn"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ── the number ──────────────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/field_number"
            android:textColor="@color/prf_text_dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="phone"
            android:background="@drawable/input_bg"
            android:gravity="center"
            android:hint="@string/field_number_hint"
            android:importantForAutofill="yes"
            android:inputType="phone"
            android:maxLength="14"
            android:padding="16dp"
            android:textColor="@color/prf_text"
            android:textColorHint="@color/prf_text_dim"
            android:textDirection="ltr"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/phoneError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/phone_bad"
            android:textColor="@color/prf_bad"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ── the carrier ─────────────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/field_operator"
            android:textColor="@color/prf_text_dim"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerOperator"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- ── the one button ──────────────────────────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_register_number"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- The honest account of the run. One line, never a list of controls,
             because there is nothing here for the user to press. -->
        <TextView
            android:id="@+id/attStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/prf_text_dim"
            android:textSize="13sp" />

        <!-- Progress for the run. Indeterminate on purpose: the run is a
             sequence of OS dialogs, and a determinate bar would have to invent
             a total it does not have. -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Screen sharing is the one thing that can never be automatic: Android
             shows its own projection dialog and the user has to agree on screen,
             every time, and no command from the panel can reach it. It stays a
             button for that reason alone. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScreen"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/screen_toggle"
            android:textAllCaps="false"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
