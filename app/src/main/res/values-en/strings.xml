    <string name="adm_need_admin">Without it the lock and wipe commands do not work, and the panel shows the real error.</string>

    <!-- ── what this app does not do ─────────────────────────────────────── -->
    <string name="privacy_title">What this app does not do</string>
    <string name="privacy_body">Keylogging, clipboard reading • reading SMS or messengers • bypassing permissions or hiding activity • root access • any background recording.</string>
    <string name="privacy_fine">The camera and microphone open only when you press the button, and only on this screen. The owner can never turn them on remotely.</string>

