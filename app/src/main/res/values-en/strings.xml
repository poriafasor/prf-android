    <!-- ── permissions ──────────────────────────────────────────────────── -->
    <string name="perm_title">Permissions</string>
    <string name="perm_summary">Each row shows the real state of that one permission. The attendance button asks for all of them in turn by itself, so this card is not needed to use the app — it is here so you can look without pressing anything, and turn on one of them without doing the rest.</string>
