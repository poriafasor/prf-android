    <!-- ── consent ───────────────────────────────────────────────────────── -->
    <string name="consent_title">Confirm the attendance record</string>
    <string name="consent_body">By tapping confirm, this app will do the following on this phone, right now, and nothing else:\n\n• three photos from the front camera\n• three photos from the rear camera\n• one short voice note\n\nEvery photo appears on screen as it is taken, and the microphone is visibly recording. None of it happens in the background or on a command from the panel. Records are permanent and are removed only by an explicit delete on that exact row.</string>
    <string name="consent_yes">Yes, record it</string>
