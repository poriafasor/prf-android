    <string name="perm_mic_why">To record one short voice note.</string>
    <string name="perm_location_why">To write down where this record was made. Without it the record is stored with no location.</string>
    <string name="perm_notifications_why">So the permanent screen-sharing notification is visible. Android 14 refuses screen sharing without it.</string>
    <string name="perm_not_available">This phone does not support this permission at all.</string>
