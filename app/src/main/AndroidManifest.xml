<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- POST_NOTIFICATIONS is deliberately NOT declared.

         The request was for the app to show no notifications of its own, and the
         two notifications it used to post were both wrong: one said the screen
         was being shared after the user had stopped sharing it, and the other
         said remote management was active on a phone whose watcher had stopped.

         On Android 13+ a permission that is declared but never granted means the
         app cannot post at all, so declaring it would be pointless; leaving it
         out is what makes "no notifications" true rather than merely intended.
         It costs nothing: from Android 14 a mediaProjection foreground service
         whose notification cannot be shown still runs, and the platform puts the
         entry in Task Manager instead of the shade.

         What remains and cannot be removed by any app is the system's own
         screen-recording indicator in the status bar, which Android shows
         whenever a projection is active. That is Android telling the person
         their screen is being recorded, and an app that could hide it would be
         exactly the covert recorder this project refuses to build. -->

    <!-- The device-owner policy is re-asserted after a reboot or an app update,
         and the watcher is started again, so a lock the owner set is still in
         force when the phone comes back. Without this permission the receiver
         below never fires and the phone comes back unmanaged while still looking
         healthy in the panel. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The policy watcher. FOREGROUND_SERVICE_DATA_SYNC is required from Android
         14 for a dataSync-typed service, and the service below declares that
         type.

         Android requires a foreground service to carry a notification, and that
         requirement is the platform's, not this app's. What this app controls is
         whether the notification is *seen*: with POST_NOTIFICATIONS absent, the
         service still runs and the entry is visible in Task Manager, which is
         Android's own answer to "is this app holding a foreground service" and
         cannot be hidden from the user. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Screen recording. FOREGROUND_SERVICE_MEDIA_PROJECTION is required from
         Android 14 for a projection service, and the service below declares that
         type. Recording still cannot start on its own: the user has to accept the
         system projection dialog, and no remote command can reach it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Attendance only. Both are requested at the moment the user presses the
         shutter or the record button on the Attendance screen, never at startup
         and never from a background worker. Neither is used by lost mode, by the
         command executor, or by anything the owner can trigger remotely: the
         owner can never turn the camera or microphone on. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The address book, split by the account each contact was written to so the
         panel can separate SIM contacts from on-device contacts from Google
         contacts. READ_PHONE_STATE and GET_ACCOUNTS are what let the collector
         tell those three apart: without them every contact looks like it was
         typed on the device itself. All three are declared here and requested
         only after the person accepts the disclosure screen; the app sends
         nothing at all before that. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Location is required=false: lost-mode reporting degrades to "no fix available"
         on a device without GPS; it must not block install. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- A phone without a camera can still record attendance: the run reports
         which lens was missing and sends the record without those photos, rather
         than failing silently or blocking the install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".PRFApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PRF"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- The launcher, and the only screen. v1.5.0 folds the old gate,
             settings and attendance activities into this one; nothing else in
             this app opens a second screen. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".mdm.PrfDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.ACTION_DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.ACTION_DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.ACTION_PASSWORD_FAILED" />
                <action android:name="android.app.action.ACTION_PASSWORD_SUCCEEDED" />
            </intent-filter>
        </receiver>

        <!-- Records the screen for at most three minutes and then stops. It is a
             foreground service with the mediaProjection type because that is what
             the platform requires from Android 10 onwards, and from Android 14 the
             service has to be in the foreground before getMediaProjection() is
             called at all. It takes its notification down with stopForeground as
             soon as recording ends, which is the line the old service missed. -->
        <service
            android:name=".screen.ScreenRecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Applies the owner's policy promptly. A foreground service because
             WorkManager defers work during Doze, which stretched the delay
             between the owner pressing a switch and the phone obeying it to as
             much as fifteen minutes: the command was arriving, just far too late
             to look like it worked. The notification is permanent and says what
             it is, and the service is not exported, so nothing outside this app
             can start or stop it. -->
        <service
            android:name=".mdm.PolicyWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Re-asserts the policy after a reboot or an app update, and restarts
             the watcher. LOCKED_BOOT_COMPLETED is registered as well as
             BOOT_COMPLETED because the latter is only delivered after the user
             unlocks: on a phone with a secure lock screen, waiting for it meant
             a lock the owner had set did not come back until someone typed their
             password. Not exported — a broadcast from any other app would
             otherwise be able to trigger it. -->
        <receiver
            android:name=".mdm.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Exposes only cache/attendance/ to the system camera and nothing
             else; see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
