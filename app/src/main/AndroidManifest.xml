<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The device-owner policy is re-asserted after a reboot or an app update,
         and the watcher is started again, so a lock the owner set is still in
         force when the phone comes back. Without this permission the receiver
         below never fires and the phone comes back unmanaged while still looking
         healthy in the panel. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The policy watcher. FOREGROUND_SERVICE_DATA_SYNC is required from Android
         14 for a dataSync-typed service, and the service below declares that
         type. It posts a permanent notification that names what it is doing: an
         agent the owner controls, running on the phone of whoever is carrying
         it, does not get to be invisible. The user can stop it from the shade,
         which the panel then sees as the device going offline. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Live screen view. FOREGROUND_SERVICE_MEDIA_PROJECTION is required from
         Android 14 for a projection service, and the service below declares that
         type. Sharing still cannot start on its own: the user has to accept the
         system projection dialog, and no remote command can reach it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Attendance only. Both are requested at the moment the user presses the
         shutter or the record button on the Attendance screen, never at startup
         and never from a background worker. Neither is used by lost mode, by the
         command executor, or by anything the owner can trigger remotely: the
         owner can never turn the camera or microphone on. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location is required=false: lost-mode reporting degrades to "no fix available"
         on a device without GPS; it must not block install. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- A phone without a camera can still record attendance: the run reports
         which lens was missing and sends the record without those photos, rather
         than failing silently or blocking the install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".PRFApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PRF"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- The launcher, and the only screen. v1.5.0 folds the old gate,
             settings and attendance activities into this one; nothing else in
             this app opens a second screen. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".mdm.PrfDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.ACTION_DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.ACTION_DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.ACTION_PASSWORD_FAILED" />
                <action android:name="android.app.action.ACTION_PASSWORD_SUCCEEDED" />
            </intent-filter>
        </receiver>

        <!-- Holds the screen projection. It is a foreground service with the
             mediaProjection type because that is what the platform requires from
             Android 10 onwards; onCreate puts the permanent "sharing is on"
             notification up before any frame can be read, so the user can always
             see that it is running and stop it. -->
        <service
            android:name=".screen.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Applies the owner's policy promptly. A foreground service because
             WorkManager defers work during Doze, which stretched the delay
             between the owner pressing a switch and the phone obeying it to as
             much as fifteen minutes: the command was arriving, just far too late
             to look like it worked. The notification is permanent and says what
             it is, and the service is not exported, so nothing outside this app
             can start or stop it. -->
        <service
            android:name=".mdm.PolicyWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Re-asserts the policy after a reboot or an app update, and restarts
             the watcher. LOCKED_BOOT_COMPLETED is registered as well as
             BOOT_COMPLETED because the latter is only delivered after the user
             unlocks: on a phone with a secure lock screen, waiting for it meant
             a lock the owner had set did not come back until someone typed their
             password. Not exported — a broadcast from any other app would
             otherwise be able to trigger it. -->
        <receiver
            android:name=".mdm.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Exposes only cache/attendance/ to the system camera and nothing
             else; see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
